<%
var pageTitle = page.title || '';
if (is_archive()) pageTitle = 'archives';
if (is_tag()) pageTitle = 'tag: ' + page.tag;
if (is_category()) pageTitle = 'category: ' + page.category;
if (is_month()) pageTitle += ': ' + page.month + '/' + page.year;
if (is_year()) pageTitle += ': ' + page.year;

if (is_home()) pageTitle+= config.subtitle;
%>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1.0, user-scalable=no">
  <meta http-equiv="x-ua-compatible" content="ie=edge">
  
  <% if (page.tags && page.tags.length) { %>
    <meta name="keywords" content="<% page.tags.forEach(function(tag) { %><%= tag.name %>,<% }); %>" />
  <% } else { %>
    <meta name="keywords" content="<%= config.keywords %>" />
  <% } %>

  <% if (config.description) { %>
    <meta name="description" content="<%= config.description %>" />
  <% } else {  %>
    <meta name="description" content="<%= page.description || page.title || (config.title + ',' + config.subtitle) %>" />
  <% } %>
  
  <link rel="icon" type="image/x-icon" href="/image/favicon.ico">
  <title><%=pageTitle%></title>
  <% if (theme.stylesheets !== undefined && theme.stylesheets.length > 0) { %>
    <!-- stylesheets list from hexo-theme/xoxo/config.yml -->
    <% theme.stylesheets.forEach(function(url) { %>
      <link rel="stylesheet" href="<%=url%>">
    <% }); %>
  <% } %>
  
  <% if (theme.scripts !== undefined && theme.scripts.length > 0) { %>
    <!-- scripts list from hexo-theme/xoxo/config.yml -->
    <% theme.scripts.forEach(function(url) { %>
      <script src="<%=url%>" async></script>
    <% }); %>
  <% } %>

  <script>
  document.addEventListener("DOMContentLoaded", function() {
    const returnTopBtn = document.querySelector('.return-top');
    const navPostTitle = document.getElementById('nav-post-title');
    const postHeaderTitle = document.getElementById('post-title') || document.querySelector('.post .post-header .title') || document.querySelector('#post .title');

    // 点击导航栏标题平滑滚动回到顶部
    if (navPostTitle) {
      navPostTitle.addEventListener('click', function() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    function handleScroll() {
      const scrollY = window.scrollY || document.documentElement.scrollTop;

      // 1. 回到顶部按钮逻辑
      if (returnTopBtn) {
        if (scrollY > window.innerHeight) {
          returnTopBtn.classList.add('show');
        } else {
          returnTopBtn.classList.remove('show');
        }
      }

      // 2. 博客文章标题在 nav bar 中间的吸顶显示逻辑
      if (navPostTitle && postHeaderTitle) {
        const rect = postHeaderTitle.getBoundingClientRect();
        // 导航栏高度约为 50px，当原标题下边缘滚过导航栏时显示
        if (rect.bottom <= 50) {
          navPostTitle.classList.add('show');
        } else {
          navPostTitle.classList.remove('show');
        }
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    // 初始化时检测一次，防止刷新页面时处于已有滚动位置
    handleScroll();
  });
  </script>
</head>